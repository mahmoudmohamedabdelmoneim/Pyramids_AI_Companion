<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/screen_background">

    <View
        android:layout_width="match_parent"
        android:layout_height="350dp"
        android:background="@drawable/top_ambient_glow" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:overScrollMode="never">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="top"
            android:orientation="vertical"
            android:paddingStart="24dp"
            android:paddingTop="30dp"
            android:paddingEnd="24dp"
            android:paddingBottom="34dp">

            <LinearLayout
                android:id="@+id/account_brand"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="30dp"
                    android:layout_height="30dp"
                    android:background="@drawable/brand_mark"
                    android:fontFamily="serif"
                    android:gravity="center"
                    android:text="𓂀"
                    android:textColor="#F4D58D"
                    android:textSize="17sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:fontFamily="sans-serif-medium"
                    android:letterSpacing="0.17"
                    android:text="AI TOURIST GUIDE"
                    android:textColor="#EEE1C5"
                    android:textSize="10sp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/account_copy"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="30dp"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-medium"
                    android:letterSpacing="0.19"
                    android:text="YOUR JOURNEY, PERSONALISED"
                    android:textColor="#D9B56A"
                    android:textSize="10sp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:fontFamily="sans-serif"
                    android:letterSpacing="0.018"
                    android:lineSpacingExtra="2dp"
                    android:text="Begin your\nGiza story"
                    android:textColor="#FFF9EE"
                    android:textSize="39sp" />

            </LinearLayout>

            <LinearLayout
                android:id="@+id/account_actions"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="28dp"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/create_account_button"
                    android:layout_width="match_parent"
                    android:layout_height="58dp"
                    android:background="@drawable/next_button"
                    android:clickable="true"
                    android:contentDescription="@string/create_account"
                    android:elevation="6dp"
                    android:focusable="true"
                    android:fontFamily="sans-serif-medium"
                    android:gravity="center"
                    android:letterSpacing="0.13"
                    android:text="@string/create_account"
                    android:textColor="#09251F"
                    android:textSize="13sp" />

                <TextView
                    android:id="@+id/sign_in_button"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:layout_marginTop="12dp"
                    android:background="@drawable/account_outline_button"
                    android:clickable="true"
                    android:contentDescription="@string/sign_in"
                    android:focusable="true"
                    android:fontFamily="sans-serif-medium"
                    android:gravity="center"
                    android:letterSpacing="0.025"
                    android:text="@string/sign_in"
                    android:textColor="#F2E2BE"
                    android:textSize="13sp" />

                <TextView
                    android:id="@+id/employee_login_button"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:layout_marginTop="12dp"
                    android:background="@drawable/employee_button"
                    android:clickable="true"
                    android:contentDescription="@string/employee_login"
                    android:focusable="true"
                    android:fontFamily="sans-serif-medium"
                    android:gravity="center"
                    android:letterSpacing="0.09"
                    android:text="@string/employee_login"
                    android:textColor="#C5DDD1"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/admin_login_button"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:layout_marginTop="12dp"
                    android:background="@drawable/employee_button"
                    android:clickable="true"
                    android:contentDescription="@string/admin_login"
                    android:focusable="true"
                    android:fontFamily="sans-serif-medium"
                    android:gravity="center"
                    android:letterSpacing="0.09"
                    android:text="@string/admin_login"
                    android:textColor="#C5DDD1"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/guest_continue_button"
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:layout_marginTop="12dp"
                    android:background="@drawable/guest_button"
                    android:clickable="true"
                    android:contentDescription="@string/guest_continue"
                    android:focusable="true"
                    android:fontFamily="sans-serif-medium"
                    android:gravity="center"
                    android:letterSpacing="0.06"
                    android:text="@string/guest_continue"
                    android:textColor="#F0DFAE"
                    android:textSize="12sp" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
</FrameLayout>
