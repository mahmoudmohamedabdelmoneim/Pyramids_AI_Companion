<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/screen_background">

    <View
        android:layout_width="match_parent"
        android:layout_height="310dp"
        android:background="@drawable/top_ambient_glow" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:overScrollMode="never">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="24dp"
            android:paddingTop="22dp"
            android:paddingEnd="24dp"
            android:paddingBottom="38dp">

            <!-- Auto-replaced by Resources/drawable/giza_photo_one.jpg when you add it. -->
            <FrameLayout
                android:id="@+id/photo_card_one"
                android:layout_width="match_parent"
                android:layout_height="186dp"
                android:background="@drawable/photo_card_border"
                android:clipToOutline="true"
                android:elevation="12dp"
                android:outlineProvider="background">

                <ImageView
                    android:id="@+id/photo_one"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:contentDescription="@string/photo_one_description"
                    android:scaleType="centerCrop"
                    android:src="@drawable/photo_placeholder_primary" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@drawable/photo_overlay" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="bottom|start"
                    android:layout_margin="17dp"
                    android:orientation="vertical">

                </LinearLayout>
            </FrameLayout>

            <!-- Auto-replaced by Resources/drawable/giza_photo_two.jpg when you add it. -->
            <FrameLayout
                android:id="@+id/photo_card_two"
                android:layout_width="match_parent"
                android:layout_height="132dp"
                android:layout_marginTop="14dp"
                android:background="@drawable/photo_card_border"
                android:clipToOutline="true"
                android:elevation="8dp"
                android:outlineProvider="background">

                <ImageView
                    android:id="@+id/photo_two"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:contentDescription="@string/photo_two_description"
                    android:scaleType="centerCrop"
                    android:src="@drawable/photo_placeholder_secondary" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@drawable/photo_overlay" />

            </FrameLayout>

            <LinearLayout
                android:id="@+id/copy_block"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="31dp"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-medium"
                    android:letterSpacing="0.20"
                    android:text="PRESENTED BY Eng. Mahmoud Khalil"
                    android:textColor="#D9B56A"
                    android:textSize="10sp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:fontFamily="serif"
                    android:lineSpacingExtra="4dp"
                    android:text="Elevate Your Experience At the Giza Plateau"
                    android:textColor="#D9E9DE"
                    android:textSize="19sp" />
            </LinearLayout>

            <View
                android:id="@+id/gold_rule"
                android:layout_width="62dp"
                android:layout_height="2dp"
                android:layout_marginTop="25dp"
                android:background="@drawable/gold_rule" />

            <TextView
                android:id="@+id/next_button"
                android:layout_width="match_parent"
                android:layout_height="58dp"
                android:layout_marginTop="27dp"
                android:background="@drawable/next_button"
                android:clickable="true"
                android:contentDescription="@string/next_description"
                android:elevation="6dp"
                android:focusable="true"
                android:fontFamily="sans-serif-medium"
                android:gravity="center"
                android:letterSpacing="0.20"
                android:text="@string/next"
                android:textColor="#09251F"
                android:textSize="13sp" />

        </LinearLayout>
    </ScrollView>

    <TextView
        android:id="@+id/ai_model_download_message"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        android:layout_marginStart="16dp"
        android:layout_marginTop="16dp"
        android:layout_marginEnd="16dp"
        android:accessibilityLiveRegion="polite"
        android:background="@drawable/photo_card_border"
        android:elevation="16dp"
        android:fontFamily="sans-serif-medium"
        android:paddingStart="18dp"
        android:paddingTop="14dp"
        android:paddingEnd="18dp"
        android:paddingBottom="14dp"
        android:text="@string/offline_ai_download_message"
        android:textColor="#FFF9EE"
        android:textSize="14sp"
        android:visibility="gone" />
</FrameLayout>
