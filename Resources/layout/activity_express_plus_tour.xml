<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/screen_background">

    <View
        android:layout_width="match_parent"
        android:layout_height="310dp"
        android:background="@drawable/top_ambient_glow" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:overScrollMode="never">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="24dp"
            android:paddingTop="24dp"
            android:paddingEnd="24dp"
            android:paddingBottom="38dp">

            <TextView
                android:id="@+id/back_button"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:background="@drawable/video_window_action"
                android:clickable="true"
                android:focusable="true"
                android:fontFamily="sans-serif-medium"
                android:gravity="center"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:text="@string/back"
                android:textColor="#F4D58D"
                android:textSize="10sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="28dp"
                android:fontFamily="serif"
                android:text="@string/express_plus_tour_title"
                android:textColor="#FFF9EE"
                android:textSize="34sp" />

            <LinearLayout
                android:id="@+id/ticket_options"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="28dp"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/photo_card_border"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:padding="20dp">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="sans-serif-medium"
                            android:text="@string/foreigners"
                            android:textColor="#FFF9EE"
                            android:textSize="19sp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="5dp"
                            android:fontFamily="serif"
                            android:text="@string/express_plus_foreigners_price"
                            android:textColor="#D9B56A"
                            android:textSize="18sp" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/foreigners_minus_button"
                        android:layout_width="42dp"
                        android:layout_height="42dp"
                        android:background="@drawable/ticket_stepper_button"
                        android:clickable="true"
                        android:contentDescription="@string/decrease_tickets"
                        android:focusable="true"
                        android:gravity="center"
                        android:text="−"
                        android:textColor="#E9FFF6"
                        android:textSize="24sp" />

                    <TextView
                        android:id="@+id/foreigners_ticket_count"
                        android:layout_width="36dp"
                        android:layout_height="42dp"
                        android:gravity="center"
                        android:text="0"
                        android:textColor="#FFF9EE"
                        android:textSize="18sp" />

                    <TextView
                        android:id="@+id/foreigners_plus_button"
                        android:layout_width="42dp"
                        android:layout_height="42dp"
                        android:background="@drawable/ticket_stepper_button"
                        android:clickable="true"
                        android:contentDescription="@string/increase_tickets"
                        android:focusable="true"
                        android:gravity="center"
                        android:text="+"
                        android:textColor="#E9FFF6"
                        android:textSize="24sp" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:background="@drawable/photo_card_border"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:padding="20dp">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="sans-serif-medium"
                            android:text="@string/egyptians"
                            android:textColor="#FFF9EE"
                            android:textSize="19sp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="5dp"
                            android:fontFamily="serif"
                            android:text="@string/express_plus_egyptians_price"
                            android:textColor="#D9B56A"
                            android:textSize="18sp" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/egyptians_minus_button"
                        android:layout_width="42dp"
                        android:layout_height="42dp"
                        android:background="@drawable/ticket_stepper_button"
                        android:clickable="true"
                        android:contentDescription="@string/decrease_tickets"
                        android:focusable="true"
                        android:gravity="center"
                        android:text="−"
                        android:textColor="#E9FFF6"
                        android:textSize="24sp" />

                    <TextView
                        android:id="@+id/egyptians_ticket_count"
                        android:layout_width="36dp"
                        android:layout_height="42dp"
                        android:gravity="center"
                        android:text="0"
                        android:textColor="#FFF9EE"
                        android:textSize="18sp" />

                    <TextView
                        android:id="@+id/egyptians_plus_button"
                        android:layout_width="42dp"
                        android:layout_height="42dp"
                        android:background="@drawable/ticket_stepper_button"
                        android:clickable="true"
                        android:contentDescription="@string/increase_tickets"
                        android:focusable="true"
                        android:gravity="center"
                        android:text="+"
                        android:textColor="#E9FFF6"
                        android:textSize="24sp" />
                </LinearLayout>
            </LinearLayout>

            <TextView
                android:id="@+id/tour_includes"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="28dp"
                android:background="@drawable/priority_pass_button"
                android:fontFamily="sans-serif-medium"
                android:lineSpacingExtra="3dp"
                android:padding="20dp"
                android:text="@string/express_plus_tour_includes"
                android:textColor="#3E2904"
                android:textSize="15sp" />
            <TextView
                android:id="@+id/add_to_cart_button"
                android:layout_width="match_parent"
                android:layout_height="58dp"
                android:layout_marginTop="20dp"
                android:background="@drawable/add_to_cart_button"
                android:clickable="true"
                android:elevation="4dp"
                android:focusable="true"
                android:fontFamily="sans-serif-medium"
                android:gravity="center"
                android:letterSpacing="0.12"
                android:text="@string/add_to_cart"
                android:textColor="#09251F"
                android:textSize="13sp" />
        </LinearLayout>
    </ScrollView>
</FrameLayout>
