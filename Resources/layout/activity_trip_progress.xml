<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/screen_background">

    <com.companyname.androidapp1.GizaPlateauMapView
        android:id="@+id/trip_progress_map"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:contentDescription="@string/giza_map_content_description" />

    <TextView
        android:id="@+id/back_button"
        android:layout_width="wrap_content"
        android:layout_height="44dp"
        android:layout_gravity="top|start"
        android:layout_marginStart="18dp"
        android:layout_marginTop="18dp"
        android:background="@drawable/video_window_action"
        android:clickable="true"
        android:elevation="8dp"
        android:focusable="true"
        android:fontFamily="sans-serif-medium"
        android:gravity="center"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:text="@string/back"
        android:textColor="#F4D58D"
        android:textSize="10sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:layout_marginStart="18dp"
        android:layout_marginEnd="18dp"
        android:layout_marginBottom="18dp"
        android:background="@drawable/photo_card_border"
        android:elevation="8dp"
        android:orientation="vertical"
        android:padding="14dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="serif"
            android:text="@string/giza_plateau_map_title"
            android:textColor="#FFF9EE"
            android:textSize="22sp" />

        <TextView
            android:id="@+id/trip_progress_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:text="@string/giza_map_waiting_for_location"
            android:textColor="#D9E9DE"
            android:textSize="13sp" />
    </LinearLayout>
</FrameLayout>
