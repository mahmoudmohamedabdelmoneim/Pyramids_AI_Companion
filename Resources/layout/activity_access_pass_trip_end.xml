<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/screen_background">

    <View
        android:layout_width="match_parent"
        android:layout_height="310dp"
        android:background="@drawable/top_ambient_glow" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:overScrollMode="never">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="24dp"
            android:paddingTop="24dp"
            android:paddingEnd="24dp"
            android:paddingBottom="38dp">

            <TextView
                android:id="@+id/access_pass_trip_end_eyebrow"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="40dp"
                android:fontFamily="sans-serif-medium"
                android:gravity="center"
                android:letterSpacing="0.18"
                android:text="@string/access_pass_trip_end_eyebrow"
                android:textColor="#D9B56A"
                android:textSize="10sp" />

            <TextView
                android:id="@+id/access_pass_trip_end_title_text"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:fontFamily="serif"
                android:gravity="center"
                android:text="@string/access_pass_trip_end_title"
                android:textColor="#FFF9EE"
                android:textSize="30sp" />

            <TextView
                android:id="@+id/access_pass_trip_end_message_text"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:background="@drawable/photo_card_border"
                android:fontFamily="sans-serif"
                android:gravity="center"
                android:lineSpacingExtra="5dp"
                android:padding="22dp"
                android:text="@string/access_pass_trip_end_message"
                android:textColor="#D9E9DE"
                android:textSize="18sp" />

            <TextView
                android:id="@+id/request_lease_extension_button"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="14dp"
                android:background="@drawable/next_button"
                android:clickable="true"
                android:contentDescription="@string/request_lease_extension_description"
                android:focusable="true"
                android:fontFamily="sans-serif-medium"
                android:gravity="center"
                android:letterSpacing="0.06"
                android:text="@string/request_lease_extension"
                android:textColor="#09251F"
                android:textSize="12sp"
                android:visibility="gone" />

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="250dp"
                android:layout_marginTop="18dp"
                android:background="@drawable/destination_map_frame"
                android:clipToOutline="true"
                android:padding="2dp">

                <com.companyname.androidapp1.GizaPlateauMapView
                    android:id="@+id/access_pass_trip_end_map"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:clickable="true"
                    android:contentDescription="@string/access_pass_trip_end_map_description"
                    android:focusable="true" />
            </FrameLayout>

            <TextView
                android:id="@+id/access_pass_trip_end_map_hint_text"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:fontFamily="sans-serif"
                android:gravity="center"
                android:text="@string/access_pass_trip_end_map_hint"
                android:textColor="#A7BDB2"
                android:textSize="13sp" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="62dp"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="26dp"
                android:elevation="12dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/open_access_pass_trip_end_chat_button"
                    android:layout_width="116dp"
                    android:layout_height="62dp"
                    android:background="@drawable/chat_fab_button"
                    android:clickable="true"
                    android:contentDescription="@string/open_ai_chat"
                    android:focusable="true"
                    android:fontFamily="sans-serif-medium"
                    android:gravity="center"
                    android:letterSpacing="0.12"
                    android:maxLines="1"
                    android:text="@string/ask_me"
                    android:textColor="#09251F"
                    android:textSize="13sp" />

                <TextView
                    android:id="@+id/access_pass_end_trip_button"
                    android:layout_width="116dp"
                    android:layout_height="62dp"
                    android:layout_marginStart="12dp"
                    android:background="@drawable/next_button"
                    android:clickable="true"
                    android:contentDescription="@string/access_pass_end_trip_description"
                    android:focusable="true"
                    android:fontFamily="sans-serif-medium"
                    android:gravity="center"
                    android:letterSpacing="0.08"
                    android:text="@string/end_trip"
                    android:textColor="#09251F"
                    android:textSize="13sp" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>

    <LinearLayout
        android:id="@+id/access_pass_trip_end_chat_panel"
        android:layout_width="match_parent"
        android:layout_height="340dp"
        android:layout_gravity="bottom"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="16dp"
        android:background="@drawable/photo_card_border"
        android:elevation="12dp"
        android:orientation="vertical"
        android:padding="14dp"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="42dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:fontFamily="sans-serif-medium"
                android:text="@string/chat_with_ai"
                android:textColor="#F4D58D"
                android:textSize="16sp" />

            <TextView
                android:id="@+id/close_access_pass_trip_end_chat_button"
                android:layout_width="42dp"
                android:layout_height="42dp"
                android:clickable="true"
                android:contentDescription="@string/close_ai_chat"
                android:focusable="true"
                android:fontFamily="sans-serif-medium"
                android:gravity="center"
                android:text="&#215;"
                android:textColor="#FFF9EE"
                android:textSize="26sp" />
        </LinearLayout>

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:fillViewport="true">

            <TextView
                android:id="@+id/access_pass_trip_end_chat_conversation"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif"
                android:lineSpacingExtra="3dp"
                android:paddingTop="8dp"
                android:paddingBottom="8dp"
                android:text="@string/access_pass_trip_end_chat_welcome"
                android:textColor="#D9E9DE"
                android:textSize="15sp" />
        </ScrollView>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:orientation="horizontal">

            <EditText
                android:id="@+id/access_pass_trip_end_chat_input"
                android:layout_width="0dp"
                android:layout_height="52dp"
                android:layout_weight="1"
                android:background="@drawable/screen_background"
                android:hint="@string/ai_chat_hint"
                android:imeOptions="actionSend"
                android:inputType="textMultiLine|textCapSentences"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:textColor="#FFF9EE"
                android:textColorHint="#A7BDB2"
                android:textSize="15sp" />

            <TextView
                android:id="@+id/access_pass_trip_end_chat_send_button"
                android:layout_width="76dp"
                android:layout_height="52dp"
                android:layout_marginStart="8dp"
                android:background="@drawable/next_button"
                android:clickable="true"
                android:focusable="true"
                android:fontFamily="sans-serif-medium"
                android:gravity="center"
                android:text="@string/send"
                android:textColor="#09251F"
                android:textSize="12sp" />
        </LinearLayout>
    </LinearLayout>

    <ScrollView
        android:id="@+id/access_pass_trip_feedback_panel"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/screen_background"
        android:elevation="20dp"
        android:fillViewport="true"
        android:overScrollMode="never"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="24dp"
            android:paddingTop="24dp"
            android:paddingEnd="24dp"
            android:paddingBottom="36dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="34dp"
                android:fontFamily="sans-serif-medium"
                android:gravity="center"
                android:letterSpacing="0.18"
                android:text="@string/trip_feedback_eyebrow"
                android:textColor="#D9B56A"
                android:textSize="10sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:fontFamily="serif"
                android:gravity="center"
                android:text="@string/trip_feedback_title"
                android:textColor="#FFF9EE"
                android:textSize="31sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:fontFamily="sans-serif"
                android:gravity="center"
                android:text="@string/trip_feedback_intro"
                android:textColor="#A7BDB2"
                android:textSize="15sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="28dp"
                android:fontFamily="sans-serif-medium"
                android:text="@string/trip_overall_rating_prompt"
                android:textColor="#FFF9EE"
                android:textSize="16sp" />

            <RatingBar
                android:id="@+id/trip_overall_rating"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:numStars="5"
                android:progressTint="#F0D188"
                android:rating="0"
                android:secondaryProgressTint="#7E6B43"
                android:stepSize="1" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="22dp"
                android:fontFamily="sans-serif-medium"
                android:text="@string/trip_highlight_prompt"
                android:textColor="#FFF9EE"
                android:textSize="16sp" />

            <EditText
                android:id="@+id/trip_highlight_input"
                android:layout_width="match_parent"
                android:layout_height="112dp"
                android:layout_marginTop="8dp"
                android:background="@drawable/photo_card_border"
                android:gravity="top|start"
                android:hint="@string/trip_highlight_hint"
                android:inputType="textMultiLine|textCapSentences"
                android:maxLines="5"
                android:padding="14dp"
                android:textColor="#FFF9EE"
                android:textColorHint="#A7BDB2"
                android:textSize="15sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="22dp"
                android:fontFamily="sans-serif-medium"
                android:text="@string/trip_improvement_prompt"
                android:textColor="#FFF9EE"
                android:textSize="16sp" />

            <EditText
                android:id="@+id/trip_improvement_input"
                android:layout_width="match_parent"
                android:layout_height="112dp"
                android:layout_marginTop="8dp"
                android:background="@drawable/photo_card_border"
                android:gravity="top|start"
                android:hint="@string/trip_improvement_hint"
                android:inputType="textMultiLine|textCapSentences"
                android:maxLines="5"
                android:padding="14dp"
                android:textColor="#FFF9EE"
                android:textColorHint="#A7BDB2"
                android:textSize="15sp" />

            <TextView
                android:id="@+id/trip_feedback_confirmation"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:background="@drawable/refund_banner"
                android:fontFamily="sans-serif-medium"
                android:gravity="center"
                android:padding="14dp"
                android:text="@string/trip_feedback_submitted"
                android:textColor="#FFD39B"
                android:textSize="15sp"
                android:visibility="gone" />

            <TextView
                android:id="@+id/submit_trip_feedback_button"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="22dp"
                android:background="@drawable/next_button"
                android:clickable="true"
                android:focusable="true"
                android:fontFamily="sans-serif-medium"
                android:gravity="center"
                android:text="@string/submit_trip_feedback"
                android:textColor="#09251F"
                android:textSize="12sp" />
        </LinearLayout>
    </ScrollView>
</FrameLayout>
