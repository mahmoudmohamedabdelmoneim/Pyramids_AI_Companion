<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/screen_background">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:overScrollMode="never">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="24dp"
            android:paddingTop="24dp"
            android:paddingEnd="24dp"
            android:paddingBottom="38dp">

            <TextView
                android:id="@+id/back_button"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:background="@drawable/video_window_action"
                android:clickable="true"
                android:focusable="true"
                android:fontFamily="sans-serif-medium"
                android:gravity="center"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:text="@string/back"
                android:textColor="#F4D58D"
                android:textSize="10sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="46dp"
                android:fontFamily="sans-serif-medium"
                android:letterSpacing="0.18"
                android:text="@string/ticket_access_eyebrow"
                android:textColor="#D9B56A"
                android:textSize="10sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:fontFamily="serif"
                android:text="@string/ticket_access_title"
                android:textColor="#FFF9EE"
                android:textSize="32sp" />

            <TextView
                android:id="@+id/ticket_access_summary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="22dp"
                android:background="@drawable/photo_card_border"
                android:fontFamily="sans-serif"
                android:lineSpacingExtra="5dp"
                android:padding="20dp"
                android:textColor="#D9E9DE"
                android:textSize="17sp" />

            <TextView
                android:id="@+id/replay_guide_button"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:layout_marginTop="18dp"
                android:background="@drawable/replay_guide_button"
                android:clickable="true"
                android:focusable="true"
                android:fontFamily="sans-serif-medium"
                android:gravity="center"
                android:letterSpacing="0.08"
                android:paddingStart="20dp"
                android:paddingEnd="20dp"
                android:text="@string/replay_ai_speech"
                android:textColor="#FFF2CE"
                android:textSize="11sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageButton
                    android:id="@+id/ticket_access_listen_button"
                    android:layout_width="52dp"
                    android:layout_height="52dp"
                    android:background="@drawable/replay_guide_button"
                    android:clickable="true"
                    android:contentDescription="@string/voice_assistant_mic_description"
                    android:focusable="true"
                    android:padding="14dp"
                    android:src="@drawable/ic_microphone" />

                <TextView
                    android:id="@+id/ticket_access_voice_status"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:layout_weight="1"
                    android:fontFamily="sans-serif"
                    android:text="@string/voice_assistant_hint"
                    android:textColor="#D9E9DE"
                    android:textSize="13sp" />
            </LinearLayout>

            <Switch
                android:id="@+id/mute_guide_switch"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/mute_ai_speech"
                android:textColor="#FFF9EE"
                android:textSize="16sp" />

            <TextView
                android:id="@+id/ticket_access_next_button"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="24dp"
                android:background="@drawable/next_button"
                android:clickable="true"
                android:elevation="4dp"
                android:focusable="true"
                android:fontFamily="sans-serif-medium"
                android:gravity="center"
                android:letterSpacing="0.12"
                android:text="@string/next_stop"
                android:textColor="#09251F"
                android:textSize="13sp" />
        </LinearLayout>
    </ScrollView>
</FrameLayout>
