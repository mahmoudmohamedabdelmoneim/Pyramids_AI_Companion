<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/screen_background"
    android:orientation="vertical"
    android:paddingStart="24dp"
    android:paddingTop="24dp"
    android:paddingEnd="24dp"
    android:paddingBottom="18dp">

    <TextView
        android:id="@+id/back_button"
        android:layout_width="wrap_content"
        android:layout_height="40dp"
        android:background="@drawable/video_window_action"
        android:clickable="true"
        android:focusable="true"
        android:fontFamily="sans-serif-medium"
        android:gravity="center"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:text="@string/back"
        android:textColor="#F4D58D"
        android:textSize="10sp" />

    <TextView
        android:id="@+id/support_chat_eyebrow_text"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="28dp"
        android:fontFamily="sans-serif-medium"
        android:letterSpacing="0.18"
        android:text="@string/support_chat_eyebrow"
        android:textColor="#D9B56A"
        android:textSize="10sp" />

    <TextView
        android:id="@+id/support_chat_title_text"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:fontFamily="serif"
        android:text="@string/support_chat_title"
        android:textColor="#FFF9EE"
        android:textSize="30sp" />

    <TextView
        android:id="@+id/support_chat_intro_text"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:fontFamily="sans-serif"
        android:text="@string/support_chat_intro"
        android:textColor="#A7BDB2"
        android:textSize="15sp" />

    <ScrollView
        android:id="@+id/support_chat_scroll"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="20dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:overScrollMode="never"
        android:paddingBottom="8dp">

        <LinearLayout
            android:id="@+id/support_chat_messages"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="bottom"
            android:orientation="vertical" />
    </ScrollView>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:gravity="bottom"
        android:orientation="horizontal">

        <EditText
            android:id="@+id/support_chat_input"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="@drawable/photo_card_border"
            android:gravity="top|start"
            android:hint="@string/support_chat_hint"
            android:inputType="textMultiLine|textCapSentences"
            android:maxLines="4"
            android:minHeight="56dp"
            android:paddingStart="14dp"
            android:paddingTop="12dp"
            android:paddingEnd="14dp"
            android:paddingBottom="12dp"
            android:textColor="#FFF9EE"
            android:textColorHint="#A7BDB2"
            android:textSize="15sp" />

        <TextView
            android:id="@+id/support_chat_send_button"
            android:layout_width="76dp"
            android:layout_height="56dp"
            android:layout_marginStart="8dp"
            android:background="@drawable/next_button"
            android:clickable="true"
            android:focusable="true"
            android:fontFamily="sans-serif-medium"
            android:gravity="center"
            android:text="@string/send"
            android:textColor="#09251F"
            android:textSize="12sp" />
    </LinearLayout>
</LinearLayout>
