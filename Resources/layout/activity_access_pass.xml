<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/screen_background">

    <View
        android:layout_width="match_parent"
        android:layout_height="310dp"
        android:background="@drawable/top_ambient_glow" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:overScrollMode="never">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="24dp"
            android:paddingTop="24dp"
            android:paddingEnd="24dp"
            android:paddingBottom="38dp">

            <TextView
                android:id="@+id/back_button"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:background="@drawable/video_window_action"
                android:clickable="true"
                android:focusable="true"
                android:fontFamily="sans-serif-medium"
                android:gravity="center"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:text="@string/back"
                android:textColor="#F4D58D"
                android:textSize="10sp" />

            <LinearLayout
                android:id="@+id/access_pass_copy"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="28dp"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-medium"
                    android:letterSpacing="0.18"
                    android:text="BOOK YOUR VISIT"
                    android:textColor="#D9B56A"
                    android:textSize="10sp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:fontFamily="serif"
                    android:text="@string/access_pass_title"
                    android:textColor="#FFF9EE"
                    android:textSize="34sp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="18dp"
                    android:background="@drawable/photo_card_border"
                    android:fontFamily="sans-serif"
                    android:lineSpacingExtra="3dp"
                    android:padding="20dp"
                    android:text="@string/access_pass_includes"
                    android:textColor="#D9E9DE"
                    android:textSize="16sp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/visitor_type_options"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="30dp"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/egyptians_button"
                    android:layout_width="match_parent"
                    android:layout_height="58dp"
                    android:background="@drawable/access_pass_button"
                    android:clickable="true"
                    android:elevation="3dp"
                    android:focusable="true"
                    android:fontFamily="sans-serif-medium"
                    android:gravity="center"
                    android:text="@string/egyptians"
                    android:textColor="#E9FFF6"
                    android:textSize="15sp" />

                <TextView
                    android:id="@+id/non_egyptians_button"
                    android:layout_width="match_parent"
                    android:layout_height="58dp"
                    android:layout_marginTop="12dp"
                    android:background="@drawable/access_pass_button"
                    android:clickable="true"
                    android:elevation="3dp"
                    android:focusable="true"
                    android:fontFamily="sans-serif-medium"
                    android:gravity="center"
                    android:text="@string/non_egyptians"
                    android:textColor="#E9FFF6"
                    android:textSize="15sp" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
</FrameLayout>
