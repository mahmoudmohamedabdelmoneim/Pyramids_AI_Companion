<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/screen_background">

    <com.companyname.androidapp1.GizaPlateauMapView
        android:id="@+id/saddle_ride_map"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:contentDescription="@string/saddle_ride_map_description" />

    <TextView
        android:id="@+id/back_button"
        android:layout_width="wrap_content"
        android:layout_height="44dp"
        android:layout_gravity="top|start"
        android:layout_marginStart="18dp"
        android:layout_marginTop="18dp"
        android:background="@drawable/video_window_action"
        android:clickable="true"
        android:elevation="8dp"
        android:focusable="true"
        android:fontFamily="sans-serif-medium"
        android:gravity="center"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:text="@string/back"
        android:textColor="#F4D58D"
        android:textSize="10sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="16dp"
        android:background="@drawable/photo_card_border"
        android:elevation="10dp"
        android:orientation="vertical"
        android:padding="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/selected_saddle_man_portrait"
                android:layout_width="54dp"
                android:layout_height="54dp"
                android:background="@drawable/avatar_circle_frame"
                android:clipToOutline="true"
                android:contentDescription="@string/selected_saddle_man_portrait_description"
                android:scaleType="centerCrop" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/selected_saddle_man_name"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="serif"
                    android:textColor="#FFF9EE"
                    android:textSize="19sp" />

                <TextView
                    android:id="@+id/selected_ride_price"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:textColor="#F0D188"
                    android:textSize="13sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/ride_timer"
                android:layout_width="104dp"
                android:layout_height="46dp"
                android:background="@drawable/ride_timer_pill"
                android:fontFamily="monospace"
                android:gravity="center"
                android:text="01:00:00"
                android:textColor="#09251F"
                android:textSize="17sp"
                android:visibility="gone" />
        </LinearLayout>

        <TextView
            android:id="@+id/saddle_ride_code_notice"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/ride_info_chip"
            android:fontFamily="sans-serif-medium"
            android:gravity="center"
            android:lineSpacingExtra="2dp"
            android:padding="12dp"
            android:text="@string/saddle_ride_code_notice"
            android:textColor="#F0D188"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/saddle_ride_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:lineSpacingExtra="3dp"
            android:text="@string/saddle_ride_time_message"
            android:textColor="#D9E9DE"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/start_saddle_ride_button"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="14dp"
            android:background="@drawable/next_button"
            android:clickable="true"
            android:focusable="true"
            android:fontFamily="sans-serif-medium"
            android:gravity="center"
            android:text="@string/start_one_hour_ride"
            android:textColor="#09251F"
            android:textSize="12sp" />
    </LinearLayout>

    <ScrollView
        android:id="@+id/ride_feedback_panel"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/screen_background"
        android:elevation="20dp"
        android:fillViewport="true"
        android:overScrollMode="never"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="24dp"
            android:paddingTop="42dp"
            android:paddingEnd="24dp"
            android:paddingBottom="36dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-medium"
                android:gravity="center"
                android:letterSpacing="0.18"
                android:text="@string/ride_complete_eyebrow"
                android:textColor="#D9B56A"
                android:textSize="10sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:fontFamily="serif"
                android:gravity="center"
                android:text="@string/ride_complete_title"
                android:textColor="#FFF9EE"
                android:textSize="31sp" />

            <TextView
                android:id="@+id/ride_end_message"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:background="@drawable/photo_card_border"
                android:gravity="center"
                android:lineSpacingExtra="4dp"
                android:padding="18dp"
                android:textColor="#D9E9DE"
                android:textSize="16sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:fontFamily="sans-serif-medium"
                android:text="@string/overall_ride_rating"
                android:textColor="#FFF9EE"
                android:textSize="16sp" />

            <RatingBar
                android:id="@+id/overall_ride_rating"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:numStars="5"
                android:progressTint="#F0D188"
                android:rating="0"
                android:secondaryProgressTint="#7E6B43"
                android:stepSize="1" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:fontFamily="sans-serif-medium"
                android:text="@string/saddle_man_attitude_rating"
                android:textColor="#FFF9EE"
                android:textSize="16sp" />

            <RatingBar
                android:id="@+id/attitude_rating"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:numStars="5"
                android:progressTint="#F0D188"
                android:rating="0"
                android:secondaryProgressTint="#7E6B43"
                android:stepSize="1" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="22dp"
                android:fontFamily="sans-serif-medium"
                android:text="@string/asked_for_extra_charge"
                android:textColor="#FFF9EE"
                android:textSize="16sp" />

            <RadioGroup
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:orientation="horizontal">

                <RadioButton
                    android:id="@+id/extra_charge_yes"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_weight="1"
                    android:buttonTint="#F0D188"
                    android:text="@string/yes"
                    android:textColor="#D9E9DE" />

                <RadioButton
                    android:id="@+id/extra_charge_no"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_weight="1"
                    android:buttonTint="#F0D188"
                    android:text="@string/no"
                    android:textColor="#D9E9DE" />
            </RadioGroup>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:fontFamily="sans-serif-medium"
                android:text="@string/given_full_hour_ride"
                android:textColor="#FFF9EE"
                android:textSize="16sp" />

            <RadioGroup
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:orientation="horizontal">

                <RadioButton
                    android:id="@+id/full_ride_yes"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_weight="1"
                    android:buttonTint="#F0D188"
                    android:text="@string/yes"
                    android:textColor="#D9E9DE" />

                <RadioButton
                    android:id="@+id/full_ride_no"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_weight="1"
                    android:buttonTint="#F0D188"
                    android:text="@string/no"
                    android:textColor="#D9E9DE" />
            </RadioGroup>

            <TextView
                android:id="@+id/refund_message"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:background="@drawable/refund_banner"
                android:fontFamily="sans-serif-medium"
                android:gravity="center"
                android:text="@string/refund_will_be_issued"
                android:textColor="#FFD39B"
                android:textSize="16sp"
                android:visibility="gone" />

            <TextView
                android:id="@+id/submit_ride_feedback_button"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="22dp"
                android:background="@drawable/next_button"
                android:clickable="true"
                android:focusable="true"
                android:fontFamily="sans-serif-medium"
                android:gravity="center"
                android:text="@string/submit_ride_feedback"
                android:textColor="#09251F"
                android:textSize="12sp" />
        </LinearLayout>
    </ScrollView>
</FrameLayout>
