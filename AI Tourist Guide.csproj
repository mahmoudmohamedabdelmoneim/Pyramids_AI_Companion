<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0-android</TargetFramework>
    <SupportedOSPlatformVersion>24</SupportedOSPlatformVersion>
    <OutputType>Exe</OutputType>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- Preserve the namespace used by the existing C# code and Android resources. -->
    <RootNamespace>AndroidApp1</RootNamespace>
    <!-- Build ARM64 packages for physical phones and x64 packages for the emulator. -->
    <RuntimeIdentifiers>android-arm64;android-x64</RuntimeIdentifiers>
    <!-- ARM64 Debug APKs are installed directly for phone testing, so they must carry the
         managed assemblies instead of depending on Visual Studio Fast Deployment files. -->
    <EmbedAssembliesIntoApk Condition="'$(Configuration)' == 'Debug' and '$(RuntimeIdentifier)' == 'android-arm64'">true</EmbedAssembliesIntoApk>
    <!-- Keep the modernized clone installable alongside the preserved original app. -->
    <ApplicationId>com.companyname.AndroidApp1.modernized</ApplicationId>
    <AssemblyName>AI Tourist Guide</AssemblyName>
    <ApplicationVersion>1</ApplicationVersion>
    <ApplicationDisplayVersion>1.0</ApplicationDisplayVersion>
    <!--
      Enables trim analyzers and full trimming during Release mode.
      To learn more, see: https://learn.microsoft.com/dotnet/core/deploying/trimming/trimming-options#trimming-granularity
    -->
    <TrimMode>full</TrimMode>
  </PropertyGroup>

  <ItemGroup>
    <!-- The bundled local voice bridge is written in Kotlin. Keep its runtime explicit now that
         the map screen no longer pulls it in transitively through Google Maps. -->
    <PackageReference Include="Xamarin.Kotlin.StdLib" Version="2.4.0.1" />
    <!-- The native runtime source and Java bridge are build inputs, not .NET Android source files. -->
    <Compile Remove="build\**\*.cs" />
    <Compile Remove="obj\**\*.cs" />
    <Compile Remove="bin\**\*.cs" />
    <!-- Keep the supplied flyer in the repository as a station reference, but do not package or render it as a map. -->
    <AndroidResource Remove="Resources\drawable-nodpi\giza_plateau_map.png" />
    <AndroidJavaSource Remove="build\**\*.java" />
    <AndroidJavaSource Remove="native\java\**\*.java" />
    <!-- AndroidJavaSource's default glob can otherwise pick up generated Java from
         prior Debug/Release builds, which causes duplicate-class javac failures. -->
    <AndroidJavaSource Remove="obj\**\*.java" />
    <AndroidJavaSource Remove="bin\**\*.java" />
    <AndroidLibrary Remove="build\**\*.jar" />
    <AndroidNativeLibrary Remove="build\**\*.so" />
    <AndroidLibrary Include="native\local-qwen-bridge.jar" Bind="false" Pack="true" />
    <!-- This bridge is invoked through the small hand-written JNI wrapper in C#.
         Keeping the JAR unbound avoids stale ABI-specific generated bindings. -->
    <AndroidLibrary Include="native\local-tour-voice-bridge.jar" Bind="false" Pack="true" />
    <!-- The ticket screen uses an explicit hold-and-release request so Kokoro can
         answer immediately. Keep the experimental Distil-Whisper asset out of
         app packages until a low-latency recognizer is introduced. -->
    <AndroidAsset Remove="Assets\stt\distil-small.en\**\*" />
    <!-- Keep the original full-precision Kokoro model as a development fallback in the
         repository, but package only the substantially smaller INT8 model. -->
    <AndroidAsset Remove="Assets\tts\kokoro-en-v0_19\model.onnx" />
    <AndroidAsset Remove="Assets\tts\kokoro-en-v0_19\*.bits" />
  </ItemGroup>

  <!-- The Qwen JNI runtime is arm64-only. Do not ship its 491 MB model to the x64 emulator
       in Debug mode, where it cannot execute and prevents normal Visual Studio deployment. -->
  <ItemGroup Condition="'$(Configuration)' == 'Debug' and '$(RuntimeIdentifier)' == 'android-x64'">
    <AndroidAsset Remove="Assets\qwen2.5-0.5b-instruct-q4_k_m.gguf" />
  </ItemGroup>
</Project>
